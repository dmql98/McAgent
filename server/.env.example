# ============================================================
# 「麦门知己」后端环境变量
# 复制为 .env 后填写。缺失关键项服务会拒绝启动并打印缺失项。
#
# ⚠️ .env 永远不要提交到 git（已在 .gitignore 里）。
#    一旦误提交过，按这个顺序处理，缺一步都算没修：
#      1. 轮换 LLM_API_KEY（去服务商后台吊销旧 key）
#      2. 更换 TOKEN_ENC_KEY 与 JWT_SECRET
#      3. 删掉 server/data/*.db（里面的 Token 密文是用旧密钥加的）
#      4. 用 git filter-repo 或重建历史，把 .env 从所有提交里抹掉后强推
#    只做「删文件 + 新提交」是不够的 —— 历史里永远能翻出来。
# ============================================================

# ---------- 必填 ----------

# 会话签名密钥。至少 32 字符。
# 生成：openssl rand -hex 32
JWT_SECRET=

# Token 加密密钥。必须是 64 位 hex（32 字节），用于 AES-256-GCM。
# 生成：openssl rand -hex 32
# ⚠️ 这个值一旦更换，所有已存 Token 都无法解密，用户需重新登录。
TOKEN_ENC_KEY=

# ---------- 服务 ----------

# 监听端口
PORT=3000

# development | production | test
NODE_ENV=development

# SQLite 数据文件所在目录（相对 server/ 或绝对路径）
DATA_DIR=./data

# ---------- 麦当劳 MCP ----------

# MCP 服务端点
MCP_ENDPOINT=https://mcp.mcd.cn

# 1 = 跳过登录时的 Token 真实性校验（只做格式检查）
# ⚠️ 仅开发期使用，生产必须为 0
MCP_VERIFY_SKIP=0

# 1 = 打印 MCP 原始请求/响应（已脱敏），联调时用
DEBUG_MCP=0

# ---------- LLM（负责 hook / quote 文案，非必需） ----------

# OpenAI 兼容接口。留空则全部走 prompts/fallbacks.ts 的模板兜底
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 单次调用超时（毫秒）
LLM_TIMEOUT_MS=20000

# ---------- 业务 ----------

# 访客每 IP 每日免费对话次数
GUEST_DAILY_LIMIT=1
